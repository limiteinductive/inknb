{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ink and butter",
  "version": "0.5.1",
  "identifier": "io.github.limiteinductive.aside",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "host",
        "title": "ink and butter",
        "width": 1180,
        "height": 820,
        "minWidth": 700,
        "minHeight": 480,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 20, "y": 28 },
        "hiddenTitle": true,
        "backgroundColor": "#f9f8f2",
        "visible": false,
        "skipTaskbar": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data: blob:; object-src 'none'; frame-src inknb-component: inknb-preview:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/512x512.png"
    ],
    "shortDescription": "A quiet place to write with your agent beside you.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML",
        "role": "Editor"
      },
      {
        "ext": [
          "tex",
          "latex"
        ],
        "name": "LaTeX",
        "role": "Editor"
      }
    ]
  }
}
